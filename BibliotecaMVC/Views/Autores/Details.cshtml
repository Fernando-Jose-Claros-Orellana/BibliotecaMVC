@model BibliotecaMVC.Models.Autor
@{
    ViewData["Title"] = "Detalle de autor";
}

<h2>Detalle de autor</h2>

<dl>
    <dt>Nombre</dt>
    <dd>@Model.Nombre</dd>
    <dt>Apellido</dt>
    <dd>@Model.Apellido</dd>
    <dt>Nacionalidad</dt>
    <dd>@Model.Nacionalidad</dd>
    <dt>Fecha de nacimiento</dt>
    <dd>@Model.FechaNacimiento.ToString("yyyy-MM-dd")</dd>
    <dt>Activo</dt>
    <dd>@(Model.Activo ? "Sí" : "No")</dd>
</dl>

<a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
