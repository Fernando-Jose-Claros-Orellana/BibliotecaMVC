@model IEnumerable<BibliotecaMVC.Models.Libro>
@{
    ViewData["Title"] = "Libros";
}

<h2>Catálogo de libros</h2>
<p>Total de libros: @Model.Count()</p>

<a asp-action="Create" class="btn btn-primary mb-3">Nuevo libro</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Título</th>
            <th>Autor</th>
            <th>Categoría</th>
            <th>Precio</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var libro in Model)
        {
            <tr>
                <td>@libro.Id</td>
                <td>@libro.Titulo</td>
                <td>@libro.Autor</td>
                <td>@libro.Categoria</td>
                <td>$@libro.Precio</td>
                <td>
                    @if (libro.Disponible)
                    {
                        <span class="badge bg-success">Disponible</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Prestado</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@libro.Id" class="btn btn-primary">Ver</a>
                    <a asp-action="Edit" asp-route-id="@libro.Id" class="btn btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@libro.Id" class="btn btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
