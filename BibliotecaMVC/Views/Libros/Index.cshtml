@model IEnumerable<BibliotecaMVC.Models.Libro>
@{
    ViewData["Title"] = "Listado de libros";
    var successMessage = TempData["SuccessMessage"] as string;
}

<h2>Listado de libros</h2>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<a asp-action="Create" class="btn btn-primary mb-3">Agregar libro</a>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay libros registrados.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Título</th>
                    <th>Autor</th>
                    <th>Categoría</th>
                    <th>ISBN</th>
                    <th>Año de publicación</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var libro in Model)
            {
            <tr>
                <td>@libro.Id</td>
                <td>@libro.Titulo</td>
                <td>@libro.Autor?.Nombre</td>
                <td>@libro.Categoria?.Nombre</td>
                <td>@(string.IsNullOrWhiteSpace(libro.ISBN) ? "-" : libro.ISBN)</td>
                <td>@(libro.AnioPublicacion.HasValue ? libro.AnioPublicacion.Value.ToString() : "-")</td>
            </tr>
            }
            </tbody>
        </table>
    </div>
}
