@model BibliotecaMVC.Models.Libro
@{
    ViewData["Title"] = "Eliminar libro";
}

<h2>Eliminar libro</h2>

<div class="alert alert-warning">¿Está seguro de eliminar este libro?</div>

@if (!string.IsNullOrEmpty(Model.ImagenUrl))
{
    <div class="mb-3">
        <img src="@Model.ImagenUrl"
             alt="Portada de @Model.Titulo"
             style="width: 220px; max-height: 320px; object-fit: cover;"
             class="img-thumbnail" />
    </div>
}
else
{
    <p class="text-muted">Este libro no tiene imagen de portada.</p>
}

<dl>
    <dt>Título</dt>
    <dd>@Model.Titulo</dd>
    <dt>Autor</dt>
    <dd>@Model.Autor</dd>
    <dt>Categoría</dt>
    <dd>@Model.Categoria</dd>
    <dt>Precio</dt>
    <dd>@Model.Precio.ToString("F2")</dd>
    <dt>Disponible</dt>
    <dd>@(Model.Disponible ? "Sí" : "No")</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
