@model BibliotecaMVC.Models.Libro
@{
    ViewData["Title"] = "Agregar libro";
}

<h2>Agregar libro</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Titulo" class="form-label"></label>
        <input asp-for="Titulo" class="form-control" />
        <span asp-validation-for="Titulo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ISBN" class="form-label"></label>
        <input asp-for="ISBN" class="form-control" />
        <span asp-validation-for="ISBN" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="AnioPublicacion" class="form-label">Año de publicación</label>
        <input asp-for="AnioPublicacion" type="number" class="form-control" />
        <span asp-validation-for="AnioPublicacion" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="AutorId" class="form-label">Autor</label>
        <select asp-for="AutorId" asp-items="ViewBag.Autores" class="form-select">
            <option value="">-- Seleccione un autor --</option>
        </select>
        <span asp-validation-for="AutorId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CategoriaId" class="form-label">Categoría</label>
        <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select">
            <option value="">-- Seleccione una categoría --</option>
        </select>
        <span asp-validation-for="CategoriaId" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
