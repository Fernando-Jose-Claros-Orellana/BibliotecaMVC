@{
    ViewData["Title"] = "Acerca de";
}

<main class="aboutPage">
    <header class="aboutHead">
        <h1>Acerca de la Biblioteca Virtual</h1>
        <p>Un espacio sencillo para consultar y organizar información bibliográfica.</p>
    </header>

    <section class="aboutWrap">
        <article class="aboutMain">
            <h2>¿Quiénes somos?</h2>
            <p>Biblioteca Virtual es una aplicación para consultar el catálogo de libros, conocer autores y revisar categorías.</p>
            <p>Buscamos apoyar la gestión bibliotecaria con información clara para estudiantes y personas interesadas en la lectura.</p>
        </article>

        <aside class="aboutSide">
            <h2>Misión</h2>
            <p>Facilitar la consulta de información bibliográfica en un solo lugar.</p>
            <h2>Visión</h2>
            <p>Ser una herramienta útil para la organización de libros y préstamos.</p>
        </aside>
    </section>

    <section class="aboutSec">
        <h2>Servicios</h2>
        <div class="serviceGrid">
            <article class="serviceCard">
                <h3>Catálogo de libros</h3>
                <p>Consulta títulos, autores y disponibilidad.</p>
            </article>
            <article class="serviceCard">
                <h3>Autores y categorías</h3>
                <p>Encuentra información organizada para tu consulta.</p>
            </article>
            <article class="serviceCard">
                <h3>Préstamos</h3>
                <p>Apoya la gestión básica de préstamos bibliotecarios.</p>
            </article>
        </div>
    </section>

    <footer class="aboutFoot">BibliotecaMVC - Gestión y consulta de información bibliográfica</footer>
</main>
